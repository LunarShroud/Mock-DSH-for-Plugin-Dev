{
  "name": "@local/mock-dsh-sandbox",
  "version": "1.0.0",
  "private": true,
  "description": "Isolated, disposable DSH sandboxes and a live-profile guard for plugin development.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "sandbox",
    "mock"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
